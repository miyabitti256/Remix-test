{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remix-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remix-test-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
